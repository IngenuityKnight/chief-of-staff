# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # required: enables the session/auth wall (middleware.ts)
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth / jobs ──────────────────────────────────────────────────
CRON_SECRET=                       # bearer token for /api/cron/* and /api/jobs/*; REQUIRED in production (fail-closed)
DEFAULT_HOUSEHOLD_ID=              # household uuid used by cron/scanner jobs (defaults to the seeded household)

# ── n8n Workflows ────────────────────────────────────────────────
N8N_INTAKE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALENDAR_WEBHOOK_SECRET=       # shared secret for /api/sync/calendar inbound; REQUIRED in production

# ── Anthropic (LLM intake routing) ───────────────────────────────
ANTHROPIC_API_KEY=                 # enables Claude routing; falls back to keywords if unset

# ── Resend (email in/out) ────────────────────────────────────────
RESEND_API_KEY=                    # outbound: Sunday report + digests
RESEND_FROM=                       # verified sender, e.g. house@yourdomain.com
RESEND_WEBHOOK_SECRET=             # inbound email webhook secret; REQUIRED in production

# ── Google Calendar (outbound write) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=              # one-time OAuth flow; googleapis handles refresh
GOOGLE_CALENDAR_ID=                # e.g. primary or specific calendar ID
GOOGLE_CALENDAR_TIMEZONE=          # e.g. America/Chicago (defaults to America/Chicago)

# ── Plaid (financial data) ───────────────────────────────────────
PLAID_CLIENT_ID=                   # from Plaid dashboard
PLAID_SECRET=                      # sandbox / development / production secret
PLAID_ENV=sandbox                  # sandbox | development | production

# ── Kroger (grocery price lookups) ───────────────────────────────
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_LOCATION_ID=                # preferred store location id

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=               # canonical origin, e.g. https://house.example.com

# ── Cameron’s private household loop (/loop) ─────────────────────
LOOP_OWNER_USER_ID=                # Cameron’s auth.users UUID; required, no implicit spouse permissions
LOOP_MODEL=claude-haiku-4-5-20251001 # optional override; without ANTHROPIC_API_KEY notices remain manually reviewable
LOOP_HOUSEHOLD_ID=                 # explicit household UUID for inbound email
LOOP_INBOUND_ADDRESS=              # exact receiving address, e.g. loop@in.yourdomain.com
LOOP_FORWARDER_EMAIL=              # Cameron’s forwarding email; no inbox access
LOOP_RESEND_WEBHOOK_SECRET=        # whsec_... for /api/loop/email; separate from legacy intake
