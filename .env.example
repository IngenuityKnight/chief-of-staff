# ── Supabase (database + magic-link sign-in) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Household ──
# Household shown on the wall and credited with taps (defaults to DEFAULT_HOUSEHOLD_ID).
WALL_HOUSEHOLD_ID=
DEFAULT_HOUSEHOLD_ID=
# Emails allowed to join the household the first time they sign in (comma-separated).
HOUSEHOLD_MEMBER_EMAILS=
# Used when the household has no timezone saved in the database.
HOUSEHOLD_TIMEZONE=America/New_York

# ── Wall kiosk (docs/WALL-AND-TAPS.md) ──
# Open https://<host>/wall?t=$WALL_TOKEN once on the iPad. 24+ chars; rotate to revoke.
WALL_TOKEN=
# Forecast location (defaults to Columbia, MD).
WALL_LATITUDE=
WALL_LONGITUDE=

# ── Google Calendar (read-only use by the wall) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
WALL_CALENDAR_IDS=
WALL_CALENDAR_LABELS=
# Calendars shown as "Busy" only (no titles or locations).
WALL_BUSY_ONLY_IDS=

# ── NFC taps ──
# Signs sticker URLs. 24+ chars. Changing it invalidates every written sticker.
TAP_SECRET=
